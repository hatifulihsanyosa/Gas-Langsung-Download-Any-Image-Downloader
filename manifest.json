{
  "manifest_version": 3,
  "name": "Gas Langsung Download Bro!",
  "version": "1.0.0",
  "description": "Anti ribet inspect element. Klik kanan atau Alt+Klik gambar mana pun (termasuk overlay & CSS background) langsung auto-download!",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}